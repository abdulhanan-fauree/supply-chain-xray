# CognoDB connection details.
#
# Create a free (c0) instance at https://console.cognodb.com/signup, then copy
# the values below from the connection panel. The password is shown exactly
# once at creation time — save it immediately.
#
# Copy this file to .env.local (gitignored) and fill in the real values:
#   cp .env.example .env.local

# Connection URI, e.g. bolt+s://abc123.databases.cognodb.cloud
COGNODB_URI=

# Username generated by CognoDB (always "cognodb" on the free tier)
COGNODB_USER=cognodb

# Generated password — shown once at instance creation
COGNODB_PASSWORD=

# Database name. Leave as "neo4j" unless your instance says otherwise.
COGNODB_DATABASE=neo4j
